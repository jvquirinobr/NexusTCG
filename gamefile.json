{
  "name": "Nexus TCG",
  "menuBackgroundImage": "https://i.pinimg.com/1200x/16/a8/3e/16a83ef05056c4dc36e250dec22a4f3b.jpg",

  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "power",
      "traits",
      "tags",
      "keywords"
    ],
    "formats": [
      {
        "title": "Standard format",
        "gameplay": "Standard",
        "deckRuleset": "Limited"
      }
    ],
    "deckRulesets": {
      "Limited": {
        "general": {
          "min": 40,
          "max": 50,
          "maxPerCard": 4
        },
        "categories": [
          {
            "category": "Sideboard",
            "min": 0,
            "max": 20
          }
        ]
      }
    }
  },

  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 7,
        "mulliganCount": {
          "max": 0
        }
      },

      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },

      "hideFacedDownCards": true,

      "countersStartingValues": [],

      "draggableTokens": [
        {
          "id": "Queimadura",
          "name": "Queimadura",
          "image": "https://cdn.uploaded.photo/2026/08/17/Queimadura.png"
        },
        {
          "id": "Veneno",
          "name": "Veneno",
          "image": "https://cdn.uploaded.photo/2026/08/17/Veneno.png"
        },
        {
          "id": "Paralisia",
          "name": "Paralisia",
          "image": "https://cdn.uploaded.photo/2026/08/17/Paralisia.png"
        },
        {
          "id": "Congelamento",
          "name": "Congelamento",
          "image": "https://cdn.uploaded.photo/2026/08/17/Congelamento.png"
        },
        {
          "id": "Sangramento",
          "name": "Sangramento",
          "image": "https://cdn.uploaded.photo/2026/08/17/Sangramento.png"
        }
      ],

      "autoPlayFromHand": {
        "Unidade": "Vanguarda",
        "UnidadeRaid": "GROUP"
      },

      "beforeGameStart": {
        "initialBoardSetup": [
          {
            "drawFromTop": "Deck",
            "count": 9,
            "destination": "Shields",
            "overrideState": {
              "isHidden": "yes"
            }
          },
          {
            "filter": {
              "type": "Unidade Especial"
            },
            "destination": "DeckEspecial",
            "moveFrom": "Deck"
          }
        ]
      },

      "sections": {
        "layout": {
          "direction": "row",

          "content": [
            {
              "direction": "column",
              "style": {
                "width": "20%"
              },
              "content": [
                {
                  "section": "Shields"
                },
                {
                  "section": "DeckEspecial"
                }
              ]
            },

            {
              "direction": "column",
              "style": {
                "width": "80%"
              },
              "content": [
                {
                  "section": "Vanguarda"
                },
                {
                  "section": "ZonaEnergia"
                }
              ]
            }
          ]
        },

        "sectionsDict": {
          "Shields": {
            "displayedTitle": "Shields",
            "isHidden": "yes",
            "height": "MEDIUM",
            "alignment": "LEFT"
          },

          "DeckEspecial": {
            "displayedTitle": "Deck Especial",
            "isHidden": "yes",
            "height": "MEDIUM",
            "alignment": "DECK",
            "isExtraDeck": true
          },

          "Vanguarda": {
            "displayedTitle": "Vanguarda",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },

          "ZonaEnergia": {
            "displayedTitle": "Zona de Energia",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          }
        }
      }
    }
  },

  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/jvquirinobr/NexusTCG/main/cards.json",
    "cardBack": "https://cdn.uploaded.photo/2026/08/17/BackArt.png",
    "version": 2
  }
}
