{
  "name": "Nexus TCG",
  "deckBuilding": {
    "mainFilters": ["Tipo", "Custo", "Unidade", "Evento", "Lutador", "Gladiador", "Atirador"],
    "formats": [
      { "title": "Standard format", "gameplay": "Standard" }
    ]
  },
  "gameplay": {
    "Standard": {
      "mulligan": { 
        "startingHandSize": 7 
      },
      "newTurn": { 
        "drawPerTurn": 1 
      },
      "hideFacedDownCards": true,
      "beforeGameStart": {
        "initialBoardSetup": [
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield1", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield2", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield3", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield4", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield5", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield6", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield7", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield8", "overrideState": { "isHidden": "yes" } },
          { "drawFromTop": "Deck", "count": 1, "destination": "Shield9", "overrideState": { "isHidden": "yes" } }
        ]
      },
      "countersStartingValues": [],
      "autoPlayFromHand": {
        "_default": "Vanguarda"
      },
      "sections": {
        "layout": {
          "direction": "row",
          "content": [
            {
              "direction": "column",
              "style": { "width": "25%" },
              "content": [
                { "section": "Shield1" },
                { "section": "Shield2" },
                { "section": "Shield3" },
                { "section": "Shield4" },
                { "section": "Shield5" },
                { "section": "Shield6" },
                { "section": "Shield7" },
                { "section": "Shield8" },
                { "section": "Shield9" }
              ]
            },
            {
              "direction": "column",
              "style": { "width": "75%" },
              "content": [
                { "section": "Vanguarda" },
                { "section": "ZonaEnergia" }
              ]
            }
          ]
        },
        "sectionsDict": {
          "Shield1": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield2": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield3": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield4": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield5": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield6": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield7": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield8": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Shield9": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "Vanguarda": {
            "title": "Vanguarda",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },
          "ZonaEnergia": {
            "title": "Zona de Energia",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/jvquirinobr/NexusTCG/main/cards.json",
