{
  "name": "Nexus TCG",
  "menuBackgroundImage": "https://criticalhits.com.br/wp-content/uploads/2020/09/animes-japao-shonen-jump.jpeg",

  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "power",
      "traits",
      "tags",
      "keywords"
    ],
    "formats": [
      {
        "title": "Standard format",
        "gameplay": "Standard"
      }
    ]
  },

  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 7,
        "mulliganCount": {
          "max": 0
        }
      },

      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },

      "hideFacedDownCards": true,

      "countersStartingValues": [],

      "draggableTokens": [
        {
          "id": "Queimadura",
          "name": "Queimadura",
          "image": "https://cdn.uploaded.photo/2026/08/17/Queimadura.png"
        },
        {
          "id": "Veneno",
          "name": "Veneno",
          "image": "https://cdn.uploaded.photo/2026/08/17/Veneno.png"
        },
        {
          "id": "Paralisia",
          "name": "Paralisia",
          "image": "https://cdn.uploaded.photo/2026/08/17/Paralisia.png"
        },
        {
          "id": "Congelamento",
          "name": "Congelamento",
          "image": "https://cdn.uploaded.photo/2026/08/17/Congelamento.png"
        },
        {
          "id": "Sangramento",
          "name": "Sangramento",
          "image": "https://cdn.uploaded.photo/2026/08/17/Sangramento.png"
        },
        {
          "id": "Geral 1",
          "name": "Geral 1",
          "image": "https://cdn.uploaded.photo/2026/08/19/Geral-1.png"
        },
        {
          "id": "Geral 2",
          "name": "Geral 2",
          "image": "https://cdn.uploaded.photo/2026/08/19/Geral-2.png"
        },
        {
          "id": "Geral 3",
          "name": "Geral 3",
          "image": "https://cdn.uploaded.photo/2026/08/19/Geral-3.png"
        }
      ],

      "autoPlayFromHand": {
        "Unidade": "Vanguarda",
        "UnidadeRaid": "GROUP"
      },

      "beforeGameStart": {
        "initialBoardSetup": [
          {
            "drawFromTop": "Deck",
            "count": 9,
            "destination": "Shields",
            "overrideState": {
              "isHidden": "yes"
            }
          }
        ]
      },

      "sections": {
        "layout": {
          "direction": "row",

          "content": [
            {
              "direction": "column",
              "style": {
                "width": "20%"
              },
              "content": [
                {
                  "section": "Shields"
                },
                {
                  "section": "DeckEspecial"
                }
              ]
            },

            {
              "direction": "column",
              "style": {
                "width": "80%"
              },
              "content": [
                {
                  "section": "Vanguarda"
                },
                {
                  "section": "ZonaEnergia"
                }
              ]
            }
          ]
        },

        "sectionsDict": {
          "Shields": {
            "displayedTitle": "Shields",
            "isHidden": "yes",
            "height": "MEDIUM",
            "alignment": "LEFT"
          },

          "DeckEspecial": {
            "displayedTitle": "Deck Especial",
            "isHidden": "yes",
            "height": "MEDIUM",
            "alignment": "DECK"
          },

          "Vanguarda": {
            "displayedTitle": "Vanguarda",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },

          "ZonaEnergia": {
            "displayedTitle": "Zona de Energia",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          }
        }
      }
    }
  },

  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/jvquirinobr/NexusTCG/refs/heads/main/cards.json",
    "cardBack": "https://cdn.uploaded.photo/2026/08/17/BackArt.png"
  }
}
