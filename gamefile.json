{
  "name": "Nexus TCG",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "tags",
      "effects"
    ],
    "formats": [
      {
        "title": "Standard format",
        "gameplay": "Standard",
        "sections": [
          {
            "id": "Unidade",
            "min": 20,
            "max": 60
          },
          {
            "id": "Unidade Especial",
            "min": 1,
            "max": 10
          }
        ]
      }
    ]
  },
  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 7
      },
      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },
      "hideFacedDownCards": true,
      "beforeGameStart": {
        "initialBoardSetup": [
          {
            "source": "Unidade Especial",
            "count": "all",
            "destination": "DeckEspecial"
          },
          {
            "source": "Unidade",
            "count": 9,
            "destination": "Shields",
            "overrideState": { "isHidden": true }
          }
        ]
      },
      "sections": {
        "layout": {
          "direction": "row",
          "content": [
            {
              "direction": "column",
              "style": { "width": "20%" },
              "content": [
                { "section": "Shields" },
                { "section": "DeckEspecial" }
              ]
            },
            {
              "direction": "column",
              "style": { "width": "80%" },
              "content": [
                { "section": "Vanguarda" },
                { "section": "ZonaEnergia" }
              ]
            }
          ]
        },
        "sectionsDict": {
          "Shields": { "displayedTitle": "Shields", "isHidden": true, "height": "MEDIUM", "alignment": "LEFT" },
          "DeckEspecial": { "displayedTitle": "Deck Especial", "isHidden": true, "height": "MEDIUM", "alignment": "DECK" },
          "Vanguarda": { "displayedTitle": "Vanguarda", "isHidden": false, "height": "MEDIUM", "alignment": "CENTER" },
          "ZonaEnergia": { "displayedTitle": "Zona de Energia", "isHidden": false, "height": "MEDIUM", "alignment": "CENTER" }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/jvquirinobr/NexusTCG/main/cards.json",
    "cardBack": "https://cdn.uploaded.photo/2026/08/17/BackArt.png"
  }
