{
  "name": "Nexus TCG",

  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "tags",
      "effects"
    ],
    "formats": [
      {
        "title": "Standard format",
        "gameplay": "Standard"
      }
    ]
  },

  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 7
      },

      "newTurn": {
        "drawOnStart": true,
        "drawPerTurn": 1
      },

      "hideFacedDownCards": true,

      "countersStartingValues": [],

      "draggableTokens": [
        {
          "id": "Queimadura",
          "name": "Queimadura",
          "image": "https://cdn.uploaded.photo/2026/08/17/Queimadura.png"
        },
        {
          "id": "Veneno",
          "name": "Veneno",
          "image": "https://cdn.uploaded.photo/2026/08/17/Veneno.png"
        },
        {
          "id": "Paralisia",
          "name": "Paralisia",
          "image": "https://cdn.uploaded.photo/2026/08/17/Paralisia.png"
        },
        {
          "id": "Congelamento",
          "name": "Congelamento",
          "image": "https://cdn.uploaded.photo/2026/08/17/Congelamento.png"
        },
        {
          "id": "Sangramento",
          "name": "Sangramento",
          "image": "https://cdn.uploaded.photo/2026/08/17/Sangramento.png"
        }
      ],

      "autoPlayFromHand": {
        "Unidade": "Vanguarda",
        "UnidadeRaid": "GROUP"
      },

      "beforeGameStart": {
        "initialBoardSetup": [
          {
            "drawFromTop": "Deck",
            "count": 9,
            "destination": "Shields",
            "overrideState": {
              "isHidden": "yes"
            }
          }
        ]
      },

      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "content": [
                {
                  "section": "Shields",
                  "style": {
                    "width": "20%"
                  }
                },
                {
                  "section": "Vanguarda",
                  "style": {
                    "width": "80%"
                  }
                }
              ]
            },

            {
              "direction": "row",
              "content": [
                {
                  "section": "UnidadesEspeciais",
                  "style": {
                    "width": "20%"
                  }
                },
                {
                  "section": "ZonaEnergia",
                  "style": {
                    "width": "80%"
                  }
                }
              ]
            }
          ]
        },

        "sectionsDict": {
          "Shields": {
            "displayedTitle": "Shields",
            "isHidden": "yes",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },

          "UnidadesEspeciais": {
            "displayedTitle": "Unidades Especiais",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },

          "Vanguarda": {
            "displayedTitle": "Vanguarda",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },

          "ZonaEnergia": {
            "displayedTitle": "Zona de Energia",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          }
        }
      }
    }
  },

  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/jvquirinobr/NexusTCG/main/cards.json",
    "cardBack": "https://cdn.uploaded.photo/2026/08/17/BackArt.png"
  }
